[headline]
standard = """**Result.** The mathematical non-reproduction rate, the share of counted pairs that fall in a \
mathematics class, is {pair_percent}: {pair_numerator} of {pair_denominator} pairs. At the entry level it is \
{entry_percent}: {entry_numerator} of {entry_denominator} counted entries have no sampled pair that reproduced. Both \
cover this seeded sample, never the whole corpus, and are set out with their denominators under [Results](#results)."""
skew = """**Result: the skew table and the method.** Version skew between the pin and the declared revision \
dominates this sample, so what this snapshot publishes is the skew table under [Results](#results), how many pairs \
reproduce at both revisions, at the pin only, at the declared revision only, at neither, or are undecided at the \
declared revision, with what the declared environment cost and the complete method that produced it, reusable on \
the next dataset. The rates are set out beside the table, never ahead of it."""
pin-only = """**Result: the pin-only table and the method.** Every sampled pair's outcome at the pin, the declared \
environment's attempts and costs, and the complete method. A pair that fails at the pin is recorded \
`environment-undeclared`, never as rejected mathematics; a pair the pin's kernel rejects on replay is reported under \
its own heading. The rates under [Results](#results) are the pin's failure rates, the share of pairs and of entries \
that fail at the pin, with no check at the declared revision behind them."""

[rates]
classes = """**Mathematical non-reproduction rates.** Each counts the pairs, or the entries, in `rejected-by-checker`, \
`axiom-audit-failure` and `rejected-by-replay`, over all those checked less the ones in `timed-out`, \
`resource-exhausted`, `harness-error`, `unclassified`, `environment-undeclared` and `environment-mismatch`, which are \
counted above and never folded into either rate.

- Pair level: {pair_numerator} of {pair_denominator} pairs, {pair_percent}; {pair_interval}.
- Entry level: {entry_numerator} of {entry_denominator} entries, {entry_percent}. An entry reproduces if at least one \
of its sampled pairs does. The rate is computed over the pairs drawn, not over every proof the entry carries, so it \
understates how often an entry has some surviving proof. No interval is quoted for it."""
pin-only = """**The pin's failure rates, with no check at the declared revision behind them.** Neither is a rate about \
the mathematics. A pair counts when its pin leg reached a result (no harness failure, timeout, resource exhaustion or \
unclassified outcome); it fails when the pin rejected it at elaboration, in the kernel, at the axiom audit or on \
replay.

- Pair level: {pair_numerator} of {pair_denominator} pin-countable pairs fail at the pin, {pair_percent}; \
{pair_interval}.
- Entry level: {entry_numerator} of {entry_denominator} pin-countable entries fail at the pin, {entry_percent}. An \
entry counts when one of its pairs does, and fails when none of its counted pairs was accepted. The rate is computed \
over the pairs drawn, not over every proof the entry carries. No interval is quoted for it."""

[shortlist]
computable = """**Kernel-rejection shortlist.** The count of `environment-mismatch` pairs that failed at the pin by a \
kernel rejection rather than an elaboration failure is {subcount}: a shortlist of candidates for later cross-kernel \
checking, neither a finding nor a bound. Whether the kernel soundness bugs fixed in Lean {floor} existed at the \
declared toolchain is not established. A pair accepted and audit-clean at the pin cannot have passed only through \
one of them. The count of sampled pairs that can have passed their publisher's check only through one is at most \
{bound}: the `environment-mismatch` pairs, the `environment-undeclared` pairs, all of which fail at the pin, and the \
`rejected-by-replay` pairs whose check at the declared revision compiled and audited clean."""
not-computable = """**Kernel-rejection shortlist.** With no result at the declared revision, the shortlist is not \
computable on this branch, which is not the same as zero. Whether the kernel soundness bugs fixed in Lean {floor} \
existed at the declared toolchain is not established. A pair accepted and audit-clean at the pin cannot have passed \
only through one of them. The count of sampled pairs that can have is at most {bound}: every pair that fails at the \
pin, a replay rejection included."""

[declared]
standing = """The check at the declared revision is compilation plus the axiom audit only: that toolchain predates \
`leanchecker`, so it is a cross-check for version skew, and no result rests on it alone. The declared environment's \
build attempts, each with its wall-clock: {attempts}. The upstream binary cache is treated differently at the pin and \
at the declared revision, deliberately. At the pin it never stands in for building the statements under audit, \
because downloaded build outputs are the publisher's own binaries and would turn the check into a repetition of the \
publisher's claim; {pin_cache}. At the declared revision the cache is permitted, because that side only cross-checks \
version skew and nothing is concluded from it alone."""
unavailable = """The declared environment, `{legacy_lean}` with Mathlib `{legacy_mathlib}`, was abandoned under its \
budget: {attempts}. Every pair that fails at the pin or at the axiom audit, a replay rejection apart, is therefore \
recorded `environment-undeclared` with its pin-side diagnostic, and every audit-clean accepted pair `reproduced`."""

[mathematics]
standing = """These pairs fail in a way the method attributes to the proof itself. `rejected-by-checker`: it fails to \
compile, or the kernel rejects it, at the pin and at the declared revision. `axiom-audit-failure`: it depends on an \
axiom outside the allowlist, or on `sorryAx`. `rejected-by-replay`: it compiled, and a kernel replay then rejected \
its declaration; a proof the pin's kernel rejects on replay does not check whatever the revision, and the declared \
toolchain has no checker that could contradict it.

