# The alternative blocks of README.md.tmpl and FINDING_REPORT.md.tmpl, chosen by the snapshot's framing, its
# status and what it recorded. Names in braces are figures from results/summary.json; no figure is written here.

skew_labels = ["reproduces at both revisions", "reproduces at the pin only",
               "reproduces at the declared revision only", "fails at both", "undecided at the declared revision"]
skew = """**Skew table.** Every pair with a result at the pin, by its outcome there and at the declared revision. A pair \
accepted and audit-clean at the pin is `reproduced` whatever its declared outcome; a pair whose declared check gave \
no result is undecided there, never a failure.

{skew_table}

Pairs not in the table, for want of a result at the pin or of a check at the declared revision: {skew_left_out}."""

[lead]
standing = """An evaluation-integrity check of a published proof corpus, and of how it reproduces across Lean versions. \
{publisher} re-checked {pairs} entry-proof pairs, drawn with the published seed {seed} from {distinct_entries} \
distinct entries of the Lean Workbook dataset (`{repo}` at revision `{revision}`), in a pinned environment {built}, \
`{pin_lean}` with Mathlib `{pin_mathlib}`, and compiled and axiom-audited each pair a second time at the \
revision the publisher declared, `{legacy_lean}` with Mathlib `{legacy_mathlib}`: compilation plus the axiom audit \
only."""
unavailable = """An evaluation-integrity check of a published proof corpus, and of how it reproduces across Lean \
versions. {publisher} re-checked {pairs} entry-proof pairs, drawn with the published seed {seed} from \
{distinct_entries} distinct entries of the Lean Workbook dataset (`{repo}` at revision `{revision}`), in a pinned \
environment {built}, `{pin_lean}` with Mathlib `{pin_mathlib}`. The revision the publisher declared, \
`{legacy_lean}` with Mathlib `{legacy_mathlib}`, could not be built within its budget, so there is no second \
environment, and the one statement about the mathematics is a replay rejection by the pin's own kernel."""

